# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Security & CORS
CORS_ORIGIN=*

# AI provider used for job-description normalization and semantic CV matching.
AI_PROVIDER=groq

# Groq API (Backend only - NEVER expose to frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Gemini fallback/provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
